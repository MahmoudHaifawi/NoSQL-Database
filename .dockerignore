# Keep the build context small and reproducible: the image builds from source inside the
# container, so host build output and runtime data must not leak in.
**/target/
.git/
.github/
.superpowers/
docs/
.idea/
*.iml
# Runtime data dirs created by a local run (the seed Node/data/info.json is kept).
Node/data/*/
app/data/
**/node_id.txt
